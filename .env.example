NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=info@worldwayswebdevelopers.co.ke
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NOTIFICATION_EMAIL=info@worldwayswebdevelopers.co.ke
INBOUND_EMAIL_WEBHOOK_SECRET=replace-with-a-separate-long-random-secret

# Optional: when set, website enquiries are also emailed to ADMIN_NOTIFICATION_EMAIL.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=info@worldwayswebdevelopers.co.ke
